// Проектирование базы данных социальной сети ВКонтакте (ДЗ №2)

Table users {
  id integer [primary key]
  name varchar
  description text
  city varchar
  interests text
  avatar_media_id integer
  created_at timestamp
}

Table posts {
  id integer [primary key]
  author_id integer
  description text
  hashtags varchar // в dbdiagram храним строкой (список через запятую)
  likes_count integer
  views_count integer
  created_at timestamp
}

Table comments {
  id integer [primary key]
  post_id integer
  author_id integer
  text text
  created_at timestamp
}

Table chats {
  id integer [primary key]
  title varchar
  is_group boolean
  created_at timestamp
}

Table chat_members {
  chat_id integer [primary key]
  user_id integer [primary key]
  joined_at timestamp
}

Table messages {
  id integer [primary key]
  chat_id integer
  sender_id integer
  text text 
  is_read boolean 
  created_at timestamp
}

Table relationships {
  user_id_from integer [primary key]
  user_id_to integer [primary key]
  rel_type varchar // 'friend', 'follower', 'romantic'
  status varchar    // например, 'married' для romantic
  updated_at timestamp
}

Table media {
  id integer [primary key]
  owner_id integer
  media_type varchar // 'photo', 'audio', 'video'
  file_url varchar
  created_at timestamp
}

Table post_media {
  post_id integer [primary key]
  media_id integer [primary key]
}

// Описание связей (Relationships)

// Анкеты и Медиа (Аватарка)
Ref: users.avatar_media_id > media.id

// Посты и авторы
Ref: posts.author_id > users.id

// Комментарии к постам
Ref: comments.post_id > posts.id
Ref: comments.author_id > users.id

// Связи чатов и участников (Многие-ко-многим)
Ref: chat_members.chat_id > chats.id
Ref: chat_members.user_id > users.id

// Сообщения в чатах
Ref: messages.chat_id > chats.id
Ref: messages.sender_id > users.id

// Отношения между пользователями
Ref: relationships.user_id_from > users.id
Ref: relationships.user_id_to > users.id

// Владелец медиафайла
Ref: media.owner_id > users.id

// Прикрепление медиа к постам (Многие-ко-многим)
Ref: post_media.post_id > posts.id
Ref: post_media.media_id > media.id